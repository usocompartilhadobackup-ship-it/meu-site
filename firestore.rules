rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidUserData() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'workouts', 'completedDays', 'totalWorkouts', 'totalMinutes', 'loadHistory',
          'notifEnabled', 'notifTime', 'notifDays', 'restOverride', 'restDefault', 'updatedAt'
        ])
        && data.workouts is list
        && data.completedDays is list
        && data.loadHistory is map;
    }

    match /users/{userId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId) && isValidUserData();
    }

    // Criado manualmente no Console do Firebase; o app nunca escreve aqui.
    match /admins/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /admin_created_users/{adminId}/users/{userId} {
      allow read, write: if isSelf(adminId) && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
